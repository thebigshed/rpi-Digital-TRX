# rpi-Digital-TRX on a Raspberry Pi Zero 2 W (on top of raspberrypizero2w_64_defconfig)
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypizero2w-64/post-build.sh $(BR2_EXTERNAL_DTRX_PATH)/board/common/post-build.sh"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_DTRX_PATH)/board/zero2w/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_DTRX_PATH)/board/zero2w/cmdline.txt"
# No Ethernet: Wi-Fi is the only network
BR2_SYSTEM_DHCP=""
