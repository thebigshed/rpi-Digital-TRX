# rpi-Digital-TRX, all boards: added by build.sh on top of Buildroot's board defconfig and
# the board's own fragment (rpi4.fragment, zero2w.fragment)

# System
BR2_TARGET_GENERIC_HOSTNAME="dtrx"
BR2_TARGET_GENERIC_ISSUE="Digital TRX"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DTRX_PATH)/board/common/rootfs-overlay"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# Wi-Fi, time, remote access
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_DROPBEAR=y

# Audio: system-wide PulseAudio (the app's microphone input needs it) and ALSA tools
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_PULSEAUDIO_DAEMON=y

# Front panel and AMBE board: i2cdetect / i2cset, and gpioget / gpioset / gpiomon for testing
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y

# Qt 6 Core and Network only: the app has no GUI (no Qt GUI, fonts or display platform)
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_NETWORK=y

# The radio
BR2_PACKAGE_CODEC2=y
BR2_PACKAGE_DIGITAL_TRANSCEIVER=y
